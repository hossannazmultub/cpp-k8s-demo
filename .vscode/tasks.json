{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake -B build -G Ninja && cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
    "label": "Static Analysis: Cppcheck",
    "type": "shell",
    "command": "cppcheck --enable=all --suppress=missingIncludeSystem --error-exitcode=1 src/",
    "problemMatcher": []
    },
    {
      "label": "Static Analysis: Clang-Tidy",
      "type": "shell",
      "command": "clang-tidy src/main.cpp -p build/",
      "problemMatcher": "$gcc"
    }
  ]
}